<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Flappy Clone</title>
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <main>
      <canvas id="game" width="400" height="600" aria-label="Flappy game"></canvas>
      <aside>
        <h2>Leaderboard</h2>
        <ol id="leaderboard"><li>Loading…</li></ol>
        <form id="submit-form" hidden>
          <label>Your name <input id="name" maxlength="20" required pattern="[A-Za-z0-9 _.\-]{1,20}" /></label>
          <button type="submit">Submit score</button>
        </form>
        <p id="message" role="status"></p>
        <p class="hint">Space, click or tap to flap.</p>
      </aside>
    </main>
    <script src="game.js"></script>
  </body>
</html>
