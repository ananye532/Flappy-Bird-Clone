* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #1e2230;
  color: #f2f2f2;
  font: 16px/1.4 system-ui, sans-serif;
}
main { display: flex; gap: 24px; flex-wrap: wrap; justify-content: center; padding: 16px; }
canvas {
  max-width: 100%;
  height: auto;
  border-radius: 8px;
  touch-action: manipulation;
  cursor: pointer;
}
aside { width: 240px; }
h2 { margin-top: 0; }
ol { padding-left: 24px; }
input { width: 100%; margin: 4px 0 8px; padding: 6px; font: inherit; }
button { padding: 6px 12px; font: inherit; cursor: pointer; }
.hint { color: #a0a4b0; font-size: 0.9rem; }
