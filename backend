"""Flappy Bird clone: leaderboard API and static file server.

import os
import re
import sqlite3
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path

from fastapi import FastAPI, HTTPException, Query
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, Field, field_validator

DB_PATH = os.getenv("DB_PATH", "scores.db")
FRONTEND_DIR = Path(__file__).resolve().parent.parent / "frontend"
MAX_SCORE = 10_000
NAME_RE = re.compile(r"^[A-Za-z0-9 _.-]{1,20}$")


@contextmanager
def db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    try:
        yield conn
        conn.commit()
    finally:
        conn.close()


def init_db() -> None:
    with db() as conn:
        conn.execute(
            """CREATE TABLE IF NOT EXISTS scores (
                   id INTEGER PRIMARY KEY AUTOINCREMENT,
                   name TEXT NOT NULL,
                   score INTEGER NOT NULL,
                   created_at TEXT NOT NULL
               )"""
        )
        conn.execute("CREATE INDEX IF NOT EXISTS ix_scores_score ON scores (score DESC)")


class ScoreIn(BaseModel):
    name: str
    score: int = Field(ge=0, le=MAX_SCORE)

    @field_validator("name")
    @classmethod
    def clean_name(cls, v: str) -> str:
        v = v.strip()
        if not NAME_RE.match(v):
            raise ValueError("name must be 1-20 characters: letters, digits, space, _ . -")
        return v


class ScoreOut(BaseModel):
    id: int
    name: str
    score: int
    created_at: str


app = FastAPI(title="Flappy Clone API", version="1.0.0")
init_db()


@app.get("/api/health")
def health() -> dict:
    return {"status": "ok"}


@app.get("/api/scores", response_model=list[ScoreOut])
def top_scores(limit: int = Query(10, ge=1, le=100)) -> list[dict]:
    with db() as conn:
        rows = conn.execute(
            "SELECT id, name, score, created_at FROM scores ORDER BY score DESC, id ASC LIMIT ?",
            (limit,),
        ).fetchall()
    return [dict(r) for r in rows]


@app.post("/api/scores", response_model=ScoreOut, status_code=201)
def submit_score(body: ScoreIn) -> dict:
    created = datetime.now(timezone.utc).isoformat(timespec="seconds")
    with db() as conn:
        cur = conn.execute(
            "INSERT INTO scores (name, score, created_at) VALUES (?, ?, ?)",
            (body.name, body.score, created),
        )
        row_id = cur.lastrowid
    if row_id is None:
        raise HTTPException(500, "insert failed")
    return {"id": row_id, "name": body.name, "score": body.score, "created_at": created}


# Serve the game itself at "/". Mounted last so /api routes take precedence.
app.mount("/", StaticFiles(directory=FRONTEND_DIR, html=True), name="frontend")
